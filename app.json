{
  "expo": {
    "name": "Get_Seen",
    "slug": "Get_Seen",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/getseen-dark-removebg-preview.png",
    "scheme": "getseen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getseen.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/getseen-dark-removebg-preview.png",
        "backgroundImage": "./assets/images/getseen-dark-removebg-preview.png",
        "monochromeImage": "./assets/images/getseen-dark-removebg-preview.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.getseen.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/getseen-light-removebg-preview.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/getseen-dark-removebg-preview.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Get_Seen to access your photos.",
          "savePhotosPermission": "Allow Get_Seen to save QR codes to your photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d72f6636-9a6f-47d5-b810-217d794268c2"
      }
    }
  }
}
